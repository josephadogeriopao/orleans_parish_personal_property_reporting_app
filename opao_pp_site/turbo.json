{
  "$schema": "https://turbo.build",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },    
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/main/java/**", "src/test/java/**", "pom.xml"],
      "outputs": ["target/surefire-reports/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": [
        "DB_USERNAME", 
        "DB_PASSWORD",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "FRONTEND_URL",
        "EMAIL_FROM_ADDRESS"
      ],
      "passThroughEnv": [
        "DB_USERNAME", 
        "DB_PASSWORD",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "FRONTEND_URL",
        "EMAIL_FROM_ADDRESS"
      ]
    },
    "migration:show": {
      "cache": false,
      "env": ["DB_USERNAME", "DB_PASSWORD"],
      "passThroughEnv": ["DB_USERNAME", "DB_PASSWORD"]
    },
    "migration:run": {
      "cache": false,
      "env": ["DB_USERNAME", "DB_PASSWORD"],
      "passThroughEnv": ["DB_USERNAME", "DB_PASSWORD"]
    },
    "migration:revert": {
      "cache": false,
      "env": ["DB_USERNAME", "DB_PASSWORD"],
      "passThroughEnv": ["DB_USERNAME", "DB_PASSWORD"]
    },
    "schema:drop": {
      "cache": false,
      "env": ["DB_USERNAME", "DB_PASSWORD"],
      "passThroughEnv": ["DB_USERNAME", "DB_PASSWORD"]
    },
    "schema:sync": {
      "cache": false,
      "inputs": ["src/main/java/**", "pom.xml"],
      "env": [
        "DB_USERNAME", 
        "DB_PASSWORD",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "FRONTEND_URL",
        "EMAIL_FROM_ADDRESS"
      ],
      "passThroughEnv": [
        "DB_USERNAME", 
        "DB_PASSWORD",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_USERNAME",
        "SMTP_PASSWORD",
        "FRONTEND_URL",
        "EMAIL_FROM_ADDRESS"
      ]
    },
    "schema:log": {
      "cache": false,
      "env": ["DB_USERNAME", "DB_PASSWORD"],
      "passThroughEnv": ["DB_USERNAME", "DB_PASSWORD"]
    },
    "seeds": {
      "cache": false,
      "inputs": ["src/main/resources/seed-data/**"]
    }
  }
}
